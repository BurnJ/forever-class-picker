{
  "rewrites": [
    {
      "source": "/classes",
      "destination": "/index.html"
    },
    {
      "source": "/classes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/keybinds",
      "destination": "/index.html"
    },
    {
      "source": "/keybinds/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/gold-farming",
      "destination": "/classes",
      "permanent": false
    },
    {
      "source": "/gold-farming/:path*",
      "destination": "/classes",
      "permanent": false
    }
  ]
}